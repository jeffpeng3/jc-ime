<?xml version="1.0" encoding="utf-8"?>
<!--
  jc 注音：per-machine MSI（WiX v5）。

  為什麼是 MSI 而不是 MSIX：`ITfInputProcessorProfiles::Register` 寫
  `HKLM\SOFTWARE\Microsoft\CTF\TIP\{CLSID}`，只有 Administrators 有寫入權；
  MSIX 的 runFullTrust 不會提升權限。理由與出處見 plan/jc-ime/tsf-plan.md。

  建置方式見 installer/README.md。這份檔案需要兩個前置變數：

    -d Version=0.1.0
    -d PayloadDir=<staging 目錄>

  安裝順序（InstallExecuteSequence）：
    InstallFiles
    WriteRegistryValues                        由 <Class>（Advertise="no"）寫
                                               HKCR\CLSID\{...}\InprocServer32：
                                               x64 元件寫 64 位元檢視，
                                               TsfDllX86（always32）寫 Wow6432Node
      → RegisterTip（deferred、SYSTEM）         RegisterProfile 與三個 RegisterCategory
    InstallFinalize
      → InstallTipLayout（immediate、使用者）   InstallLayoutOrTip(ILOT_INSTALL)

  反安裝順序：
    RemoveRegistryValues（標準順序 2600）       由 <Class> 移除兩個檢視的 CLSID
    UnregisterTip（deferred、SYSTEM）           UnregisterProfile 與三個
                                                UnregisterCategory
    RemoveFiles（3500）
    InstallFinalize
      → RemoveTipLayout（immediate、使用者）    只刪 %LOCALAPPDATA%\jc-ime；
                                                不呼叫 ILOT_UNINSTALL

  為什麼 CLSID 交給 MSI：rc.5／rc.6 由 DLL 的 DllRegisterServer 自己寫，結果
  RegisterCategory 在 64 位元檢視的 CLSID 還沒出現時就存取違規（0xC0000005）。
  交給 MSI 之後，機碼的寫入與移除由 Windows Installer 排進標準動作，自訂動作
  只要接在正確的一側。詳見 docs/port/tsf-installer.md。

  `<Class>` 用 Advertise="no"（不要 Windows Installer 的 advertised class 行為），
  所以 WiX 產生的是 Registry table 的資料列，不是 Class table：
    - 寫入：WriteRegistryValues（標準順序 5000）
    - 移除：RemoveRegistryValues（2600）
  RegisterClassInfo／UnregisterClassInfo 只處理 Class table，與這裡無關。因此
  UnregisterTip 必須排在 RemoveRegistryValues 之前（2600 < 2700 < 3500），
  UnregisterProfile 執行時 CLSID 還在。

  為什麼反安裝不呼叫 ILOT_UNINSTALL：移除語系的最後一個 layout 時，Windows 會
  把系統地區改成英文。參考專案為此停用這一步（windows-chewing-tsf issue 553）。

  為什麼有兩份 DLL：TSF 依宿主行程的位元數載入 TIP，32 位元程式（舊版 Office、
  部分工具）只找得到 32 位元的 COM 註冊（`Wow6432Node`）。兩份共用同一個 CLSID
  與 profile，使用者的語言清單只有一項；詳見 docs/port/x86-tip.md。

  檔案與機碼都由 MSI 或上述自訂動作建立／移除；沒有 Permanent 元件。
-->
<?ifndef Version ?>
  <?error 未指定 Version：wix build -d Version=<x.y.z> -d PayloadDir=<dir> installer/jc-ime.wxs ?>
<?endif ?>
<?ifndef PayloadDir ?>
  <?error 未指定 PayloadDir：wix build -d Version=<x.y.z> -d PayloadDir=<dir> installer/jc-ime.wxs ?>
<?endif ?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="jc 注音"
      Manufacturer="jc-ime"
      Version="$(var.Version)"
      UpgradeCode="{6A97C593-1BE9-414D-B654-650FBDC98B66}"
      Language="1028"
      Codepage="950"
      Scope="perMachine"
      Compressed="yes">

    <SummaryInformation
        Description="jc 注音（TSF 輸入法）"
        Manufacturer="jc-ime" />

    <!-- AllowSameVersionUpgrades：開發期版本號常停在 0.1.0，重裝同一版時要
         就地升級，不要留下兩個「jc 注音」項目。 -->
    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="已安裝較新版本的 jc 注音。請先從「應用程式與功能」移除目前版本，再安裝這一版。" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- 反安裝時是否保留 %LOCALAPPDATA%\jc-ime（settings.json、personal.json）。
         預設 0：完全清除，符合「移除後不留下檔案」的要求。
         使用者資料是使用者自己的設定，想保留時在命令列加 KEEPUSERSETTINGS=1。 -->
    <Property Id="KEEPUSERSETTINGS" Value="0" Secure="yes" />

    <Feature Id="Main" Title="jc 注音" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="DataFiles" />
      <ComponentGroupRef Id="LegalFiles" />
      <ComponentRef Id="EngineAutostart" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="LegalShortcut" />
    </Feature>

    <InstallExecuteSequence>
      <!-- 安裝／修復：WriteRegistryValues 寫完 <Class> 的 CLSID 之後才註冊 profile
           與分類，RegisterCategory 執行時類別工廠已經查得到。 -->
      <Custom Action="RollbackRegisterTip" Before="RegisterTip" Condition="NOT REMOVE" />
      <Custom Action="RegisterTip" After="WriteRegistryValues" Condition="NOT REMOVE" />

      <!-- 反安裝：先移除 profile，再讓 MSI 移除 CLSID 與檔案。
           UnregisterTip 一定要排在 RemoveRegistryValues 之前：<Class> 用
           Advertise="no"，WiX 產生的 CLSID 機碼是 Registry table 的資料列，由
           RemoveRegistryValues（2600）刪除，比 UnregisterClassInfo（2700）與
           RemoveFiles（3500）都早。排在 RemoveFiles 之前不夠，那時 CLSID 已經
           不在了。 -->
      <Custom Action="RollbackUnregisterTip" Before="UnregisterTip"
              Condition='REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE' />
      <Custom Action="UnregisterTip" Before="RemoveRegistryValues" Condition='REMOVE~="ALL"' />

      <!-- 使用者語言清單：必須在 SYSTEM 的註冊完成之後、且以使用者身分執行。
           RemoveTipLayout 只清使用者資料，不從語言清單移除 layout。 -->
      <Custom Action="InstallTipLayout" After="InstallFinalize" Condition="NOT REMOVE" />
      <Custom Action="RemoveTipLayout" After="InstallFinalize"
              Condition='REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE' />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="jc-ime">
        <Directory Id="LEGALDIR" Name="legal">
          <Directory Id="LICENSEDIR" Name="licenses" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="SHAREDDIR" Name="jc-ime">
        <Directory Id="DATADIR" Name="data">
          <Directory Id="PACKSDIR" Name="packs" />
          <Directory Id="BUILDZHDIR" Name="build-zh" />
          <Directory Id="ENGLISHDIR" Name="english" />
          <Directory Id="MODELSDIR" Name="models">
            <Directory Id="EXTERNALDIR" Name="external">
              <Directory Id="JINENDIR" Name="jinen-v2-small" />
            </Directory>
            <Directory Id="QUANTDIR" Name="quant">
              <Directory Id="JINENXSMALLDIR" Name="jinen-v2-xsmall" />
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="jc 注音" />
    </StandardDirectory>
  </Fragment>

  <!--
    程式檔案。jc-tip-register.exe 必須留到 RemoveFiles 之後才刪，因為反安裝的
    UnregisterTip 會呼叫它。

    兩份 TSF DLL：`jc-tsf.dll` 是 x64，`jc-tsf-x86.dll` 是 i686。兩個檔案共用同一個
    CLSID，只是註冊在不同機碼檢視；檔名分開是因為兩份都放在同一個目錄。x86 的
    Component 標 `Bitness="always32"`（WiX v5 的元件架構寫法），機碼與檔案才不會
    被當成 64 位元元件處理。

    CLSID 由 <Class> 註冊，不是由 DLL 的 DllRegisterServer。這裡用
    Advertise="no"，WiX 會把 CLSID 寫成 Registry table 的資料列（不是 Class
    table），所以兩個檢視的 InprocServer32 都由 WriteRegistryValues 寫入、
    RemoveRegistryValues 移除；RegisterClassInfo／UnregisterClassInfo 不參與。
    省略 Server 表示伺服器就是同一個 <File>，所以 File 必須 KeyPath="yes"。
  -->
  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="TsfDll" Guid="{BA82E245-0AC8-4CE0-8350-48A1AA127BDE}">
        <File Id="FileTsfDll"
              Source="$(var.PayloadDir)/jc-tsf.dll"
              KeyPath="yes"
              Vital="yes">
          <Class Id="7B7D6E1A-3C1F-4B2E-9A55-6C1D2F3E4A01"
                 Context="InprocServer32"
                 ThreadingModel="apartment"
                 Advertise="no"
                 Description="jc 注音" />
        </File>
      </Component>

      <Component Id="TsfDllX86"
                 Guid="{1B4E9C60-2A7D-4E51-9C3F-7A6D5B8E2140}"
                 Bitness="always32">
        <File Id="FileTsfDllX86"
              Source="$(var.PayloadDir)/jc-tsf-x86.dll"
              KeyPath="yes"
              Vital="yes">
          <!-- 同一個 CLSID；Bitness="always32" 讓 WiX 寫進 Wow6432Node。 -->
          <Class Id="7B7D6E1A-3C1F-4B2E-9A55-6C1D2F3E4A01"
                 Context="InprocServer32"
                 ThreadingModel="apartment"
                 Advertise="no"
                 Description="jc 注音" />
        </File>
      </Component>

      <Component Id="EngineExe" Guid="{B47CE81B-061C-48BC-BF03-4BB96A5CDEFD}">
        <File Id="FileEngine"
              Source="$(var.PayloadDir)/jc-engine.exe"
              KeyPath="yes"
              Vital="yes" />
      </Component>

      <Component Id="CliExe" Guid="{161787AE-C16F-41F3-9661-232D7E6AF446}">
        <File Id="FileCli"
              Source="$(var.PayloadDir)/jc-cli.exe"
              KeyPath="yes"
              Vital="yes" />
      </Component>

      <Component Id="SettingsUiExe" Guid="{40AD23EB-884D-4284-9A5D-082579E0AFDB}">
        <File Id="FileSettingsUi"
              Source="$(var.PayloadDir)/jc-settings-ui.exe"
              KeyPath="yes"
              Vital="yes" />
      </Component>

      <Component Id="SmokeExe" Guid="{B3A54B49-E3B9-4DD8-AB91-A240E93959BE}">
        <File Id="FileSmoke"
              Source="$(var.PayloadDir)/jc-tsf-smoke.exe"
              KeyPath="yes" />
      </Component>

      <Component Id="TipRegisterExe" Guid="{4CCDFDDE-8BC0-4BB6-89CC-2D9FF5FD2550}">
        <File Id="FileTipRegister"
              Source="$(var.PayloadDir)/jc-tip-register.exe"
              KeyPath="yes"
              Vital="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!--
    隨產品散布的資料。清單來自資料根目錄的 manifest.json（shipped: true）；
    下載項（Funmula 的 zh-select、zh-punct）依授權不可隨產品散布，因此不在這裡。
    manifest.json 本身要一起裝，引擎啟動時用它比對存在與大小。
  -->
  <Fragment>
    <ComponentGroup Id="DataFiles">
      <Component Id="DataManifest" Directory="DATADIR"
                 Guid="{D701FE40-1CBC-4E4E-B4EB-6B88075A8C62}">
        <File Id="FileDataManifest"
              Source="$(var.PayloadDir)/data/manifest.json"
              KeyPath="yes" />
      </Component>

      <Component Id="JaPack" Directory="PACKSDIR"
                 Guid="{A0FCC959-A481-4F59-B72F-AED8054CE7BA}">
        <File Id="FileJaPack"
              Source="$(var.PayloadDir)/data/packs/ja-lexicon-mozc-v2.pack"
              KeyPath="yes" />
      </Component>

      <Component Id="ZhLexicon" Directory="BUILDZHDIR"
                 Guid="{8C1F60C2-2F96-447E-BDF6-EE16466C8B9B}">
        <File Id="FileZhLexicon"
              Source="$(var.PayloadDir)/data/build-zh/lexicon.bin"
              KeyPath="yes" />
      </Component>

      <Component Id="ZhLm" Directory="BUILDZHDIR"
                 Guid="{9D2A3407-77F8-45ED-BAFF-B73977339230}">
        <File Id="FileZhLm"
              Source="$(var.PayloadDir)/data/build-zh/lm.bin"
              KeyPath="yes" />
      </Component>

      <Component Id="EnglishWords" Directory="ENGLISHDIR"
                 Guid="{FCF93FC8-9038-493C-9D69-FDE475E29CEF}">
        <File Id="FileEnglishWords"
              Source="$(var.PayloadDir)/data/english/words.bin"
              KeyPath="yes" />
        <File Id="FileEnglishManifest"
              Source="$(var.PayloadDir)/data/english/manifest.json" />
        <File Id="FileEnglishNotice"
              Source="$(var.PayloadDir)/data/english/NOTICE.txt" />
      </Component>

      <Component Id="JaNeural" Directory="JINENDIR"
                 Guid="{785BEA44-E4A3-4D31-BFD7-514F4180E8D1}">
        <File Id="FileJaNeural"
              Source="$(var.PayloadDir)/data/models/external/jinen-v2-small/jinen-v2-small-Q5_K_M.gguf"
              KeyPath="yes" />
      </Component>

      <Component Id="JaTokenizer" Directory="JINENXSMALLDIR"
                 Guid="{B4C7A2D1-6E58-4F0B-9A3C-2D8E5F71C904}">
        <File Id="FileJaTokenizer"
              Source="$(var.PayloadDir)/data/models/quant/jinen-v2-xsmall/tokenizer.json"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!--
    授權文件。全部集中在 %ProgramFiles%\jc-ime\legal\：AGPL 全文、專案 NOTICE、
    第三方逐來源聲明與 legal/licenses\ 的授權全文。

    payload 內的相對路徑與 repo 相同（LICENSE、NOTICE、legal/...），所以
    check-payload.py 可以直接拿 repo 的檔案比對雜湊，少一份複本。

    這些是普通元件，反安裝跟著 RemoveFiles 一起刪，不設 Permanent。
    新增 legal/licenses/ 的檔案時，這裡與 build.ps1 的清單要同步；
    check-payload.py 會因為「repo 有、WXS 沒引用」而失敗。
  -->
  <Fragment>
    <ComponentGroup Id="LegalFiles" Directory="LEGALDIR">
      <Component Id="LegalLicense" Guid="{D384D9B6-2FB5-4CDF-9C27-78117151C842}">
        <File Id="FileLegalLicense"
              Source="$(var.PayloadDir)/LICENSE"
              KeyPath="yes" />
      </Component>

      <Component Id="LegalNotice" Guid="{0E67EF78-718B-4D8B-8AD5-7807BC8F8634}">
        <File Id="FileLegalNotice"
              Source="$(var.PayloadDir)/NOTICE"
              KeyPath="yes" />
      </Component>

      <Component Id="LegalThirdParty" Guid="{A3CA19A0-74A1-4F50-AC7C-73EA551B814B}">
        <File Id="FileLegalThirdParty"
              Source="$(var.PayloadDir)/legal/THIRD-PARTY-NOTICES.md"
              KeyPath="yes" />
      </Component>

      <Component Id="LegalLicensesReadme" Directory="LICENSEDIR"
                 Guid="{DC3BA438-3911-4800-8252-4BDD5966CE27}">
        <File Id="FileLegalLicensesReadme"
              Source="$(var.PayloadDir)/legal/licenses/README.md"
              KeyPath="yes" />
      </Component>

      <Component Id="LegalApache2" Directory="LICENSEDIR"
                 Guid="{DD901767-11A7-4305-8A5E-27017F1CD709}">
        <File Id="FileLegalApache2"
              Source="$(var.PayloadDir)/legal/licenses/Apache-2.0.txt"
              KeyPath="yes" />
      </Component>

      <Component Id="LegalCcBy4" Directory="LICENSEDIR"
                 Guid="{C69B6ED6-E7B2-4634-AD7C-EBC8D7C3C177}">
        <File Id="FileLegalCcBy4"
              Source="$(var.PayloadDir)/legal/licenses/CC-BY-4.0.txt"
              KeyPath="yes" />
      </Component>

      <Component Id="LegalCcBySa3" Directory="LICENSEDIR"
                 Guid="{A8E8F900-932F-4934-8AA6-A0393F02580B}">
        <File Id="FileLegalCcBySa3"
              Source="$(var.PayloadDir)/legal/licenses/CC-BY-SA-3.0.txt"
              KeyPath="yes" />
      </Component>

      <Component Id="LegalCcBySa4" Directory="LICENSEDIR"
                 Guid="{B12DB657-6D8A-47EF-B982-B8C7B0249EA8}">
        <File Id="FileLegalCcBySa4"
              Source="$(var.PayloadDir)/legal/licenses/CC-BY-SA-4.0.txt"
              KeyPath="yes" />
      </Component>

      <Component Id="LegalEnglishDataNotice" Directory="LICENSEDIR"
                 Guid="{3DD33FDE-37AA-4DCF-AB94-657B0F58B71E}">
        <File Id="FileLegalEnglishDataNotice"
              Source="$(var.PayloadDir)/legal/licenses/ENGLISH-DATA-NOTICE.txt"
              KeyPath="yes" />
      </Component>

      <Component Id="LegalEsdbScolw" Directory="LICENSEDIR"
                 Guid="{4E8C2E39-3483-47A0-A540-0A1E9BC1DE80}">
        <File Id="FileLegalEsdbScolw"
              Source="$(var.PayloadDir)/legal/licenses/ESDB-SCOWL-LICENSE.txt"
              KeyPath="yes" />
      </Component>

      <Component Id="LegalIpadic" Directory="LICENSEDIR"
                 Guid="{73FC11EC-9099-4E45-9F31-2F4D83AFED6E}">
        <File Id="FileLegalIpadic"
              Source="$(var.PayloadDir)/legal/licenses/IPADIC-COPYING.txt"
              KeyPath="yes" />
      </Component>

      <Component Id="LegalMit" Directory="LICENSEDIR"
                 Guid="{94303EA6-80B7-4519-971E-2B7A4D000D82}">
        <File Id="FileLegalMit"
              Source="$(var.PayloadDir)/legal/licenses/MIT.txt"
              KeyPath="yes" />
      </Component>

      <Component Id="LegalMitFunmula" Directory="LICENSEDIR"
                 Guid="{0D11AB9C-7E7F-497A-B401-26B653B9FE20}">
        <File Id="FileLegalMitFunmula"
              Source="$(var.PayloadDir)/legal/licenses/MIT-Funmula.txt"
              KeyPath="yes" />
      </Component>

      <Component Id="LegalMozcLicense" Directory="LICENSEDIR"
                 Guid="{5008BFFB-D857-474D-9234-2B44ACC05481}">
        <File Id="FileLegalMozcLicense"
              Source="$(var.PayloadDir)/legal/licenses/Mozc-LICENSE.txt"
              KeyPath="yes" />
      </Component>

      <Component Id="LegalMozcReadme" Directory="LICENSEDIR"
                 Guid="{9568EA88-095C-4B65-8762-C88082D3138D}">
        <File Id="FileLegalMozcReadme"
              Source="$(var.PayloadDir)/legal/licenses/Mozc-README.txt"
              KeyPath="yes" />
      </Component>

      <Component Id="LegalUnidicArtifact" Directory="LICENSEDIR"
                 Guid="{20F13D42-37D5-4A95-ACDF-38F4BA7D0E39}">
        <File Id="FileLegalUnidicArtifact"
              Source="$(var.PayloadDir)/legal/licenses/UNIDIC-BSD-2025.12-artifact.txt"
              KeyPath="yes" />
      </Component>

      <Component Id="LegalUnidicConsortium" Directory="LICENSEDIR"
                 Guid="{4BB076A5-641B-45AA-A960-BDD11C628A5C}">
        <File Id="FileLegalUnidicConsortium"
              Source="$(var.PayloadDir)/legal/licenses/UNIDIC-BSD-consortium.txt"
              KeyPath="yes" />
      </Component>

      <Component Id="LegalUnidicCopying" Directory="LICENSEDIR"
                 Guid="{328A1492-8D7A-4D40-91DB-957B862CA70B}">
        <File Id="FileLegalUnidicCopying"
              Source="$(var.PayloadDir)/legal/licenses/UNIDIC-COPYING.txt"
              KeyPath="yes" />
      </Component>

      <Component Id="LegalUnidicAuthors" Directory="LICENSEDIR"
                 Guid="{1D66FBD0-3CF9-41C4-9AC4-CF033E5A9D20}">
        <File Id="FileLegalUnidicAuthors"
              Source="$(var.PayloadDir)/legal/licenses/UNIDIC-AUTHORS.md"
              KeyPath="yes" />
      </Component>

      <Component Id="LegalZhDataNotice" Directory="LICENSEDIR"
                 Guid="{AD6721DC-3110-4766-9A6E-5825575D635C}">
        <File Id="FileLegalZhDataNotice"
              Source="$(var.PayloadDir)/legal/licenses/ZH-DATA-NOTICE.txt"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!--
    引擎開機自動啟動。

    tsf-skeleton 的 worker 只連 named pipe，不會自己拉起引擎；沒有這個 Run
    項目，安裝完 Win+Space 看得到「jc 注音」，但輸入不會有反應。

    值用 REG_EXPAND_SZ（Type="expandable"），`%LOCALAPPDATA%` 在每位使用者
    登入時各自展開，所以同一條 HKLM 值對所有使用者都成立。settings.json 放在
    使用者目錄，資料在 ProgramData。
  -->
  <Fragment>
    <Component Id="EngineAutostart" Directory="INSTALLFOLDER"
               Guid="{28B7FF4A-8D07-4C5F-AEE6-CCF43F7B717F}">
      <RegistryKey Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run">
        <RegistryValue
            Name="jc-ime-engine"
            Type="expandable"
            KeyPath="yes"
            Value="&quot;[INSTALLFOLDER]jc-engine.exe&quot; --data &quot;[DATADIR]&quot; --settings &quot;%LOCALAPPDATA%\jc-ime\settings.json&quot; --socket jc-ime" />
      </RegistryKey>
    </Component>
  </Fragment>

  <!--
    開始功能表的設定程式捷徑。捷徑只帶 `settings`，由 jc-tip-register.exe
    在執行時展開 %LOCALAPPDATA% 再啟動 jc-settings-ui.exe。

    不在 Arguments 直接寫 `%LOCALAPPDATA%`：.lnk 的參數在啟動時不會展開環境
    變數，per-machine 捷徑也不能寫死某個使用者的路徑。
  -->
  <Fragment>
    <Component Id="StartMenuShortcut" Directory="ProgramMenuDir"
               Guid="{1ED6CD3E-7703-43B1-AD2F-E9713ED20419}">
      <Shortcut Id="SettingsShortcut"
                Name="jc 注音設定"
                Description="調整 jc 注音的輸入模式、選字與候選數量"
                Target="[INSTALLFOLDER]jc-tip-register.exe"
                Arguments="settings"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveProgramMenuDir" On="uninstall" />
    </Component>
  </Fragment>

  <!--
    開始功能表的「授權」捷徑。目標是 legal\THIRD-PARTY-NOTICES.md，透過
    `jc-tip-register legal` 開啟：乾淨的 Windows 對 .md 沒有預設關聯，讓 .lnk
    直接指向檔案會跳出「選擇應用程式」，輔助程式在沒有關聯時退回記事本。
  -->
  <Fragment>
    <Component Id="LegalShortcut" Directory="ProgramMenuDir"
               Guid="{A36C5EB9-32D4-4C4B-81D5-1B1400A60B90}">
      <Shortcut Id="LicenseShortcut"
                Name="jc 注音授權"
                Description="授權條款與第三方聲明（AGPL-3.0-only、CC-BY-SA-4.0、Apache-2.0 等）"
                Target="[INSTALLFOLDER]jc-tip-register.exe"
                Arguments="legal"
                WorkingDirectory="INSTALLFOLDER" />
    </Component>
  </Fragment>

  <!--
    自訂動作。ExeCommand 只帶子命令：machine-* 不接參數，CLSID 與 DLL 路徑都由
    MSI 的 <Class> 負責。

    machine-* 一定要 Impersonate="no"：CTF 機碼在 HKLM，需要 SYSTEM 權限。
    user-* 一定要 Impersonate="yes"：InstallLayoutOrTip 寫的是呼叫者的 HKCU。

    RegisterTip 排在 WriteRegistryValues 之後：<Class Advertise="no"> 的機碼由
    WriteRegistryValues 寫入，所以此時兩個檢視的 CLSID 都在，RegisterCategory
    不會拿到不存在的類別工廠。反安裝的 UnregisterTip 排在 RemoveRegistryValues
    之前，UnregisterProfile 執行時 CLSID 也還在；兩邊各清各的，不互相搶。
    詳見 docs/port/tsf-installer.md。
  -->
  <Fragment>
    <CustomAction Id="RegisterTip"
                  FileRef="FileTipRegister"
                  ExeCommand="machine-register"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <CustomAction Id="RollbackRegisterTip"
                  FileRef="FileTipRegister"
                  ExeCommand="machine-unregister"
                  Execute="rollback"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="UnregisterTip"
                  FileRef="FileTipRegister"
                  ExeCommand="machine-unregister"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="RollbackUnregisterTip"
                  FileRef="FileTipRegister"
                  ExeCommand="machine-register"
                  Execute="rollback"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="InstallTipLayout"
                  FileRef="FileTipRegister"
                  ExeCommand="user-install"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />

    <!-- 名稱沿用 RemoveTipLayout，但只跑 user-uninstall 清使用者資料
         （ExeCommand 帶 [KEEPUSERSETTINGS]，1 代表保留）；語言清單那一步是
         no-op，不呼叫 ILOT_UNINSTALL。 -->
    <CustomAction Id="RemoveTipLayout"
                  FileRef="FileTipRegister"
                  ExeCommand="user-uninstall [KEEPUSERSETTINGS]"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />
  </Fragment>
</Wix>
